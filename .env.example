# ── Models ──────────────────────────────────────────────
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_GEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
RAG_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
RAG_DEVICE=auto                     # auto, cpu, cuda, mps

# ── Verifier ────────────────────────────────────────────
RAG_HRR_DIM=2048                    # HRR vector dimension (>=512)
RAG_USE_STRUCTURAL=true             # Enable HRR role-filler check
RAG_USE_ENTAILMENT=true             # Enable NLI entailment check
RAG_W_EMBEDDING=0.30                # Fusion weight: embedding similarity
RAG_W_STRUCTURAL=0.30               # Fusion weight: HRR structural
RAG_W_ENTAILMENT=0.40               # Fusion weight: NLI entailment
RAG_T_CORRECT=0.62                  # Threshold: CORRECT verdict
RAG_T_INCORRECT=0.40                # Threshold: INCORRECT verdict

# ── Pipeline ────────────────────────────────────────────
RAG_TOP_K=5                         # Chunks retrieved per query
RAG_MIN_CORRECT=2                   # Min CORRECT chunks to skip rewrite
RAG_MAX_RETRIES=2                   # Query rewrite retries
RAG_AGENT_MAX_STEPS=6               # Max agentic loop steps
RAG_MAX_NEW_TOKENS=256              # Max generation tokens

# ── Infra ───────────────────────────────────────────────
RAG_INDEX_DIR=data/index            # FAISS index persistence path
RAG_LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
RAG_LOG_JSON=false                  # JSON-structured logging for prod
RAG_REQUEST_TIMEOUT_S=120.0         # Per-query timeout

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
